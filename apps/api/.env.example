NODE_ENV=development
PORT=4000
# Runtime: Supabase transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&schema=assessment
# Prisma CLI/migrations: direct or Supabase session pooler (port 5432).
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require&schema=assessment
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h
ALLOWED_ORIGINS=http://localhost:3000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=15000
BUSINESS_TIMEZONE=Asia/Karachi
LOG_FILE=logs/api.log
