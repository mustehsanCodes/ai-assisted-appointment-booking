enum MessageRole {
  USER
  ASSISTANT
}

enum AiStatus {
  PENDING
  COMPLETED
  FAILED
}

model ChatSession {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingDraft        Json          @default("{}")
  processingToken     String?       @db.Uuid
  processingStartedAt DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  messages            ChatMessage[]

  @@index([userId, updatedAt, id])
}

model ChatMessage {
  id               String      @id @default(uuid()) @db.Uuid
  sessionId        String      @db.Uuid
  session          ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String      @db.VarChar(2000)
  clientMessageId  String?     @db.Uuid
  aiStatus         AiStatus    @default(COMPLETED)
  replyToMessageId String?     @unique @db.Uuid
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([sessionId, clientMessageId])
  @@index([sessionId, createdAt, id])
}
